        function aplicarFiltrosCabecera() {
            var filtrados = [];
            for(var i=0; i<resultadosBase.length; i++){
                filtrados.push(resultadosBase[i]);
            }

            // 1. FILTRO DE MARCA (MÁQUINAS)
            if (marcaTacticaSeleccionada !== "") {
                var temp = [];
                var marcaLimpia = textoPlano(marcaTacticaSeleccionada);
                var terminosValidos = [marcaLimpia];
                
                if (relacionMarcaModelo[marcaTacticaSeleccionada]) {
                    var hijosMaq = relacionMarcaModelo[marcaTacticaSeleccionada];
                    for (var hm=0; hm<hijosMaq.length; hm++) terminosValidos.push(textoPlano(hijosMaq[hm]));
                }
                
                for(var j=0; j<filtrados.length; j++){
                    var mText = textoPlano(filtrados[j].marca);
                    var modText = textoPlano(filtrados[j].modelo);
                    var signText = textoPlano(filtrados[j].sign);
                    
                    var coincidencia = false;
                    for (var tv=0; tv<terminosValidos.length; tv++) {
                        if (mText.indexOf(terminosValidos[tv]) > -1 || modText.indexOf(terminosValidos[tv]) > -1 || signText.indexOf(terminosValidos[tv]) > -1) {
                            coincidencia = true;
                            break;
                        }
                    }

                    if (coincidencia) temp.push(filtrados[j]);
                }
                filtrados = temp;
            }
            
            actualizarDesplegableModelosYTipos(filtrados);
            
            // 2. FILTRO MODELO/SIGN
            var modeloSel = modeloTactivoSeleccionado !== "" ? modeloTactivoSeleccionado : (document.getElementById('filtroModelo') ? document.getElementById('filtroModelo').value : "");
            if (modeloSel !== "") {
                var temp2 = [];
                var modSelLimpio = textoPlano(modeloSel);
                for(var k=0; k<filtrados.length; k++){
                    var strAComparar = textoPlano(filtrados[k].modeloSignUnificado);
                    if (strAComparar.indexOf(modSelLimpio) > -1) { 
                        temp2.push(filtrados[k]); 
                    }
                }
                filtrados = temp2;
            }

            // 3. FILTRO TIPO UNIFICADO
            var tipoSel = document.getElementById('filtroTipo') ? document.getElementById('filtroTipo').value : "";
            if (tipoSel !== "") {
                var temp3 = [];
                var tipoSelLimpio = textoPlano(tipoSel);
                for(var t=0; t<filtrados.length; t++){
                    var stringComparar = textoPlano(filtrados[t].tipoUnificado);
                    if (stringComparar.indexOf(tipoSelLimpio) > -1) { 
                        temp3.push(filtrados[t]); 
                    }
                }
                filtrados = temp3;
            }
            
            var cat = selectCat.value;
            var search = document.getElementById('searchInput').value.trim();
            
            if (cat === "" && search === "" && marcaTacticaSeleccionada === "" && modeloTactivoSeleccionado === "") {
                vistaListado.style.display = 'none';
            } else {
                if(columnaOrden !== -1) { ordenarDatosInterno(filtrados); }
                renderizarTabla(filtrados, "No se encontraron componentes para esta selección.", true);
            }
        }

        function ordenarTabla(colIndex) {
            if (columnaOrden === colIndex) { ordenAscendente = !ordenAscendente; } 
            else { columnaOrden = colIndex; ordenAscendente = true; }

            for(var i=0; i<=2; i++) {
                var icono = document.getElementById('sortIcon'+i);
                if(icono) icono.className = 'sort-icon fa-solid fa-sort';
            }
            var iconoActivo = document.getElementById('sortIcon'+colIndex);
            if(iconoActivo) {
                iconoActivo.className = ordenAscendente ? 'sort-icon active fa-solid fa-sort-up' : 'sort-icon active fa-solid fa-sort-down';
            }

            aplicarFiltrosCabecera();
        }

        function ordenarDatosInterno(arreglo) {
            if(columnaOrden === -1) return;
            arreglo.sort(function(a, b) {
                var valA = ""; var valB = "";
                if (columnaOrden === 0) {
                    valA = a.navision.toLowerCase();
                    valB = b.navision.toLowerCase();
                } else if (columnaOrden === 1) {
                    valA = a.codigoON.toLowerCase();
                    valB = b.codigoON.toLowerCase();
                } else {
                    valA = a.descripcion.toLowerCase();
                    valB = b.descripcion.toLowerCase();
                }
                
                if (valA < valB) return ordenAscendente ? -1 : 1;
                if (valA > valB) return ordenAscendente ? 1 : -1;
                return 0;
            });
        }

        function mostrarListado() {
            var cat = selectCat.value;
            vistaDetalle.style.display = 'none';
            document.getElementById('searchInput').value = ""; 
            
            if(document.getElementById('filtroModelo')) document.getElementById('filtroModelo').value = "";
            if(document.getElementById('filtroTipo')) document.getElementById('filtroTipo').value = "";
            
            marcaTacticaSeleccionada = "";
            modeloTactivoSeleccionado = "";
            carouselNivel = 'MARCA';
            tipoMenuActivo = 'AMBOS';
            menuPrincipalContainer.style.display = 'block'; 
            
            if(cat === "") { 
                vistaListado.style.display = 'none'; 
                resultadosBase = baseDeDatos;
                actualizarCarousel(baseDeDatos); 
                return; 
            }
            
            resultadosBase = [];
            for(var i=0; i<baseDeDatos.length; i++){
                if (textoPlano(baseDeDatos[i].categoria) === textoPlano(cat)) resultadosBase.push(baseDeDatos[i]);
            }
            
            actualizarCarousel(resultadosBase); 
            aplicarFiltrosCabecera(); 
        }

        function ejecutarBusqueda() {
            var inputStr = document.getElementById('searchInput').value;
            var inputLimpio = limpiarTexto(inputStr);
            vistaDetalle.style.display = 'none';
            
            if (inputLimpio === "") { 
                mostrarListado(); 
                return; 
            }
            
            selectCat.value = ""; 
            menuPrincipalContainer.style.display = 'none'; 
            
            if(document.getElementById('filtroModelo')) document.getElementById('filtroModelo').value = "";
            if(document.getElementById('filtroTipo')) document.getElementById('filtroTipo').value = "";
            
            var terminos = inputLimpio.split(/\s+/);
            
            resultadosBase = [];
            for(var i=0; i<baseDeDatos.length; i++){
                var item = baseDeDatos[i];
                var valoresAplastados = Object.keys(item).map(function(k) { return item[k]; });
                var txtCompleto = limpiarTexto(valoresAplastados.join(" "));
                
                var matchesAll = true;
                for(var t=0; t<terminos.length; t++){
                    if(txtCompleto.indexOf(terminos[t]) === -1) {
                        matchesAll = false; break;
                    }
                }
                if (matchesAll) resultadosBase.push(item);
            }
            
            marcaTacticaSeleccionada = ""; 
            modeloTactivoSeleccionado = "";
            carouselNivel = 'MARCA';
            tipoMenuActivo = 'AMBOS';
            actualizarCarousel(resultadosBase);
            aplicarFiltrosCabecera();
        }

        // ====================================================================
        // RENDERIZADO DE TABLAS
        // ====================================================================
        var resultadosEnTabla = [];
        function renderizarTabla(resultados, mensajeVacio, resetearPaginacion) {
            if (resetearPaginacion) {
                paginaActual = 1;
                resultadosEnTabla = resultados;
                tablaCuerpo.innerHTML = '';
            }
            
            var inicio = (paginaActual - 1) * filasPorPagina;
            var fin = paginaActual * filasPorPagina;
            var lote = resultadosEnTabla.slice(inicio, fin);

            if(resultadosEnTabla.length === 0) {
                tablaCuerpo.innerHTML = '<tr><td colspan="6" style="text-align:center;">' + escapeHTML(mensajeVacio) + '</td></tr>';
                document.getElementById('btnCargarMas').style.display = 'none';
            } else {
                for(var i=0; i<lote.length; i++){
                    var item = lote[i];
                    var tr = document.createElement('tr');
                    tr.onclick = (function(currentItem) {
                        return function() { mostrarDetalle(currentItem); };
                    })(item);
                    
                    var html = '<td>' + escapeHTML(item.navision || '-') + '</td>';
                    html += '<td>' + escapeHTML(item.codigoON || '-') + '</td>';
                    html += '<td>' + escapeHTML(item.descripcion) + '</td>';
                    html += '<td>' + generarChipsHTML(item.marca) + '</td>';
                    html += '<td>' + generarChipsHTML(item.modeloSignUnificado) + '</td>';
                    html += '<td>' + generarChipsHTML(item.tipoUnificado) + '</td>';
                    
                    tr.innerHTML = html;
                    tablaCuerpo.appendChild(tr);
                }
                
                if (fin < resultadosEnTabla.length) { document.getElementById('btnCargarMas').style.display = 'block'; } 
                else { document.getElementById('btnCargarMas').style.display = 'none'; }
            }
            vistaListado.style.display = 'block';
        }

        function cargarMasPagina() {
            paginaActual++;
            renderizarTabla(resultadosEnTabla, "", false);
        }

        // ====================================================================
        // LLENADO DE VISTA DETALLE
        // ====================================================================
        function mostrarDetalle(itemData) {
            if (window.history && window.history.pushState) {
                if (vistaListado.style.display === 'block') {
                    var estadoLista = { 
                        cat: selectCat.value, 
                        busq: document.getElementById('searchInput').value, 
                        marcaTactil: marcaTacticaSeleccionada, 
                        modelo: document.getElementById('filtroModelo') ? document.getElementById('filtroModelo').value : "",
                        tipo: document.getElementById('filtroTipo') ? document.getElementById('filtroTipo').value : ""
                    };
                    window.history.pushState({ view: 'detalle', state: estadoLista }, "");
                }
            }

            vistaListado.style.display = 'none';
            menuPrincipalContainer.style.display = 'none';
            
            document.getElementById('detDescripcion').textContent = itemData.descripcion || "-";
            document.getElementById('detCodigoNav').textContent = itemData.navision || "-";
            document.getElementById('detCodigoON').textContent = itemData.codigoON || "-";
            
            document.getElementById('detEquipo').innerHTML = generarChipsHTML(itemData.equipo);
            document.getElementById('detCat').textContent = itemData.categoria || "-";
            document.getElementById('detSubcat').textContent = itemData.subCategoria || "-";

            document.getElementById('detMarca').innerHTML = generarChipsHTML(itemData.marca);
            document.getElementById('detModeloSign').innerHTML = generarChipsHTML(itemData.modeloSignUnificado);
            document.getElementById('detTipo').innerHTML = generarChipsHTML(itemData.tipoUnificado);

            document.getElementById('detReparable').innerHTML = generarChipsHTML(itemData.reparable);
            document.getElementById('detSolicitante').innerHTML = generarChipsHTML(itemData.solicitante);

            var linkRefacciones = document.getElementById('linkRefacciones');
            var refDe = itemData.refaccion;
            
            if (refDe.trim() !== "") {
                linkRefacciones.innerHTML = 'Pertenece a: ' + escapeHTML(refDe) + ' <i class="fa-solid fa-link"></i>';
                linkRefacciones.style.display = 'flex'; 
                linkRefacciones.onclick = function() { abrirModalPadres(itemData); };
            } else { 
                linkRefacciones.innerHTML = 'Ver refacciones asociadas <i class="fa-solid fa-magnifying-glass-plus"></i>';
                linkRefacciones.style.display = 'flex'; 
                linkRefacciones.onclick = function() { abrirModalRefacciones(itemData); };
            }

            var imgElement = document.getElementById('detImagen');
            var visor3D = document.getElementById('detModelo3D');
            var btnInfo = document.getElementById('btnInfoOculto');
            
            urlInfoActual = itemData.plano;

            if (itemData.modelo3D.trim() !== "") {
                imgElement.style.display = 'none'; 
                visor3D.src = itemData.modelo3D; 
                visor3D.style.display = 'block';
            } else {
                visor3D.style.display = 'none'; 
                visor3D.src = ""; 
                imgElement.src = itemData.foto; 
                imgElement.style.display = 'block';
            }
            
            if (urlInfoActual.trim() !== "") {
                btnInfo.style.display = 'flex'; 
            } else { 
                btnInfo.style.display = 'none'; 
            }
            
            vistaDetalle.style.display = 'block';
        }
        
        function abrirDocumentoInfo() {
            if (urlInfoActual !== "") {
                var link = document.getElementById('linkDocOculto');
                link.href = urlInfoActual; link.click(); 
            }
        }

        // ====================================================================
        // MODALES
        // ====================================================================
        function abrirModalRefacciones(componentePadre) {
            var refacciones = [];
            var navPadre = limpiarTexto(componentePadre.navision);
            var onPadre = limpiarTexto(componentePadre.codigoON);
            
            for(var i=0; i<baseDeDatos.length; i++){
                var item = baseDeDatos[i];
                var refStr = item.refaccion;
                if (refStr !== "") {
                    var refArray = refStr.split(',');
                    var hayCoincidencia = false;
                    for (var r=0; r<refArray.length; r++) {
                        var refLimpia = limpiarTexto(refArray[r]);
                        if ((navPadre !== "" && refLimpia.indexOf(navPadre) > -1) || (onPadre !== "" && refLimpia.indexOf(onPadre) > -1)) {
                            hayCoincidencia = true;
                            break;
                        }
                    }
                    if (hayCoincidencia) refacciones.push(item);
                }
            }
            if(refacciones.length > 0) renderizarModalLista(refacciones, "Listado de refacciones");
            else alert("No se encontraron refacciones asociadas para este componente.");
        }

        function abrirModalPadres(componenteHijo) {
            var refStrHijo = componenteHijo.refaccion;
            if (refStrHijo === "") return;
            
            var padres = [];
            var refArrayHijo = refStrHijo.split(',');

            for(var i=0; i<baseDeDatos.length; i++){
                var item = baseDeDatos[i];
                var nav = limpiarTexto(item.navision);
                var on = limpiarTexto(item.codigoON);
                
                var esPadre = false;
                for (var r=0; r<refArrayHijo.length; r++) {
                    var refLimpia = limpiarTexto(refArrayHijo[r]);
                    if ((nav !== "" && refLimpia.indexOf(nav) > -1) || (on !== "" && refLimpia.indexOf(on) > -1)) {
                        esPadre = true;
                        break;
                    }
                }
                if (esPadre) padres.push(item);
            }
            
            if (padres.length > 0) renderizarModalLista(padres, "Pertenece a");
            else alert("No se encontró la ficha principal en la base de datos.");
        }

        function renderizarModalLista(lista, titulo) {
            var modal = document.getElementById('modalGenerico');
            var tbody = document.getElementById('modalTablaCuerpo');
            document.getElementById('modalTitulo').textContent = titulo;
            tbody.innerHTML = ''; 

            if (lista.length > 0) {
                for(var i=0; i<lista.length; i++){
                    var item = lista[i];
                    var tr = document.createElement('tr');
                    tr.style.cursor = 'pointer'; 
                    tr.onclick = (function(currentItem) {
                        return function() { cerrarModal(); mostrarDetalle(currentItem); };
                    })(item);
                    
                    var html = '<td style="text-align: center;"><img src="' + escapeHTML(item.foto) + '" alt="Miniatura" class="modal-img" onerror="this.onerror=null; this.src=\'https://placehold.co/600x400/eeeeee/333333?text=Sin+Imagen\';"></td>';
                    html += '<td>' + escapeHTML(item.navision || '-') + '</td>';
                    html += '<td>' + escapeHTML(item.codigoON || '-') + '</td>';
                    html += '<td style="border-right: none;">' + escapeHTML(item.descripcion) + '</td>';
                    
                    tr.innerHTML = html;
                    tbody.appendChild(tr);
                }
            } else {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding: 30px;">No se encontraron resultados.</td></tr>';
            }
            modal.style.display = 'flex';
        }

        function cerrarModal() { document.getElementById('modalGenerico').style.display = 'none'; }
        function cerrarModalFuera(e) { if (e.target && e.target.className && e.target.className.indexOf('modal-overlay') > -1) cerrarModal(); }

        window.addEventListener('popstate', function(e) {
            cerrarModal(); 
            
            if (!e.state || e.state.view === 'listado') {
                vistaDetalle.style.display = 'none';
                
                if (e.state && e.state.state) {
                    if(e.state.state.cat !== undefined && document.getElementById('categoriaSelect')) document.getElementById('categoriaSelect').value = e.state.state.cat;
                    if(e.state.state.tipo !== undefined && document.getElementById('filtroTipo')) document.getElementById('filtroTipo').value = e.state.state.tipo;
                }

                var search = document.getElementById('searchInput').value.trim();
                
                if (search === "") {
                    vistaListado.style.display = (selectCat.value === "" && marcaTacticaSeleccionada === "" && modeloTactivoSeleccionado === "") ? 'none' : 'block';
                    menuPrincipalContainer.style.display = 'block';
                } else {
                    vistaListado.style.display = 'block';
                    menuPrincipalContainer.style.display = 'none'; 
                }
            } 
            else if (e.state && e.state.view === 'detalle') {
                vistaDetalle.style.display = 'block';
                vistaListado.style.display = 'none';
                menuPrincipalContainer.style.display = 'none';
            }
        });
    </script>
</body>
