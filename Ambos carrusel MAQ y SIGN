        function textoPlano(texto) {
            if (texto === undefined || texto === null) return "";
            return String(texto).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]/g, "");
        }

        function limpiarTexto(texto) {
            if (texto === undefined || texto === null) return "";
            return String(texto).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
        }

        function normalizarItem(item) {
            var flatItem = {};
            for (var key in item) {
                if (item.hasOwnProperty(key) && item[key] !== undefined && item[key] !== null) {
                    var cleanKey = key.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]/g, "");
                    flatItem[cleanKey] = String(item[key]).replace(/\n/g, ',').trim();
                }
            }

            var itemLimpio = {};
            itemLimpio.navision = flatItem['navision'] || flatItem['columna1'] || flatItem['codigonavision'] || "";
            itemLimpio.codigoON = flatItem['codigoon'] || "";
            itemLimpio.descripcion = flatItem['descripcion'] || "";
            itemLimpio.equipo = flatItem['equipo'] || "";
            itemLimpio.categoria = flatItem['categoria'] || "";
            itemLimpio.subCategoria = flatItem['subcategoria'] || "";
            itemLimpio.marca = flatItem['marca'] || "";
            itemLimpio.modelo = flatItem['modelo'] || "";
            itemLimpio.sign = flatItem['sign'] || "";
            itemLimpio.tipoSign = flatItem['tiposign'] || "";
            itemLimpio.tipoMaquina = flatItem['tipomaquina'] || "";
            itemLimpio.reparable = flatItem['reparable'] || "";
            itemLimpio.refaccion = flatItem['refaccion'] || flatItem['refaccionde'] || flatItem['relacion'] || "";
            itemLimpio.solicitante = flatItem['quienpuedesolicitarlarefaccion'] || flatItem['solicitante'] || "";
            itemLimpio.foto = flatItem['foto'] || flatItem['imagen'] || flatItem['img'] || "";
            itemLimpio.modelo3D = flatItem['modelo3d'] || "";
            itemLimpio.plano = flatItem['enlacedeinformacionplanosengoogledrive'] || flatItem['plano'] || flatItem['infourl'] || "";

            itemLimpio.tipoUnificado = (itemLimpio.tipoMaquina + " " + itemLimpio.tipoSign).trim();
            if(itemLimpio.tipoUnificado === "") itemLimpio.tipoUnificado = flatItem['tipo'] || flatItem['material'] || "";

            itemLimpio.modeloSignUnificado = (itemLimpio.modelo + " " + itemLimpio.sign).trim();

            return itemLimpio;
        }

        document.addEventListener("DOMContentLoaded", function() {
            var timeoutSeguridad = setTimeout(function() {
                mostrarError({message: "Tiempo agotado. Revisa la conexión con el servidor."});
            }, 15000);

            try {
                if (typeof google !== 'undefined' && google.script) {
                    google.script.run
                        .withSuccessHandler(function(datos) {
                            clearTimeout(timeoutSeguridad); 
                            iniciarAplicacion(datos);
                        })
                        .withFailureHandler(function(err) {
                            clearTimeout(timeoutSeguridad); 
                            mostrarError(err);
                        })
                        .obtenerDatosDeExcel();
                } else {
                    clearTimeout(timeoutSeguridad);
                    mostrarError({message: "Entorno de Google Script no detectado."});
                }
            } catch (err) {
                clearTimeout(timeoutSeguridad);
                mostrarError({message: "Error de ejecución: " + err.message});
