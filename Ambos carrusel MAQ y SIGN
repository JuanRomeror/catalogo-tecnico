<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Consulta de Componentes - Operaciones del Norte</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js"></script>
    
    <style>
        :root { --primary-blue: #0f355c; --light-gray: #f2f2f2; --border-color: #333333; --text-dark: #333333; --text-light: #ffffff; }
        body { font-family: 'Roboto', sans-serif; margin: 0; padding: 20px; background-color: #ffffff; color: var(--text-dark); display: flex; justify-content: center; }
        .app-container { width: 100%; max-width: 900px; background-color: #ffffff; padding: 40px; }

        /* HEADER LOGO */
        .header-logo { display: flex; justify-content: flex-end; margin-bottom: 30px; }
        .header-logo-img { max-height: 70px; width: auto; object-fit: contain; }

        /* CONTROLES */
        .control-row { display: flex; margin-bottom: 20px; border: 1px solid var(--border-color); height: 35px; }
        .control-label { background-color: var(--primary-blue); color: var(--text-light); font-weight: 500; padding: 0 20px; display: flex; align-items: center; justify-content: center; width: 250px; letter-spacing: 0.5px; text-align: center; }
        .control-input { flex-grow: 1; display: flex; background-color: var(--light-gray); }
        .control-input input { width: 100%; border: none; background-color: transparent; padding: 0 15px; font-family: 'Roboto', sans-serif; font-size: 14px; outline: none; }
        .select-wrapper { flex-grow: 1; display: flex; position: relative; background-color: var(--light-gray); }
        .select-wrapper select { appearance: none; -webkit-appearance: none; cursor: pointer; width: 100%; border: none; background-color: transparent; padding: 0 15px; font-family: 'Roboto', sans-serif; font-size: 14px; outline: none; }
        .select-arrow { position: absolute; right: 0; top: 0; height: 100%; width: 40px; border-left: 1px solid var(--border-color); display: flex; justify-content: center; align-items: center; pointer-events: none; background-color: #fff; }
        .search-btn { background-color: #fff; border: none; border-left: 1px solid var(--border-color); width: 40px; cursor: pointer; display: flex; justify-content: center; align-items: center; color: var(--text-dark); }
        .search-btn:hover { background-color: #e0e0e0; }

        /* CARRUSEL SEPARADO (MÁQUINAS Y SIGNS) */
        .carousel-container { width: 100%; overflow: hidden; margin-bottom: 25px; display: none; }
        .carousel-title { font-size: 14px; font-weight: 700; color: var(--primary-blue); margin-bottom: 12px; text-transform: uppercase; border-bottom: 2px solid var(--primary-blue); padding-bottom: 5px; }
        .carousel-track { display: flex; overflow-x: auto; gap: 15px; padding-bottom: 15px; -webkit-overflow-scrolling: touch; scroll-behavior: smooth; align-items: stretch; }
        .carousel-track::-webkit-scrollbar { height: 8px; }
        .carousel-track::-webkit-scrollbar-thumb { background-color: var(--primary-blue); border-radius: 4px; }
        
        .carousel-card { flex: 0 0 auto; width: 140px; background: #fff; border: 2px solid var(--light-gray); border-radius: 8px; overflow: hidden; cursor: pointer; transition: all 0.2s ease; display: flex; flex-direction: column; align-items: center; justify-content: space-between; }
        .carousel-card:hover { border-color: #a0c4ff; transform: translateY(-3px); box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
        .carousel-card.active { border-color: var(--primary-blue); background-color: #e6f2ff; box-shadow: 0 5px 15px rgba(15,53,92,0.25); transform: scale(1.02); }
        .carousel-img-container { width: 100%; height: 170px; background-color: #fff; display: flex; justify-content: center; align-items: center; padding: 10px; box-sizing: border-box; }
        .carousel-img { max-width: 100%; max-height: 100%; object-fit: contain; }
        .carousel-label { width: 100%; padding: 10px 5px; background-color: var(--light-gray); color: var(--primary-blue); font-weight: 700; font-size: 12px; text-align: center; text-transform: uppercase; transition: background 0.2s; }
        .carousel-card.active .carousel-label { background-color: var(--primary-blue); color: #fff; }

        .carousel-card.large { width: 320px; border-radius: 12px; }
        .carousel-card.large .carousel-img-container { height: 320px; padding: 20px; }
        .carousel-card.large .carousel-label { font-size: 16px; padding: 15px 5px; }

        /* TABLA PRINCIPAL DE RESULTADOS */
        .results-table-container { margin-top: 10px; border: 1px solid var(--border-color); display: none; overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; table-layout: auto; min-width: 800px; }
        th { background-color: var(--primary-blue); color: var(--text-light); text-align: left; padding: 10px 15px; font-weight: 500; border-bottom: 2px solid var(--border-color); border-right: 1px solid rgba(255,255,255,0.2); white-space: nowrap; vertical-align: top; cursor: pointer; user-select: none; }
        th:hover { background-color: #16497d; }
        td { padding: 10px 15px; border-bottom: 1px solid var(--border-color); border-right: 1px solid #ddd; font-size: 14px; }
        #vistaListado td:nth-child(1), #vistaListado td:nth-child(2) { white-space: nowrap; width: 1%; }
        #vistaListado td:nth-child(3) { width: 30%; }
        tr:nth-child(even) { background-color: var(--light-gray); }
        tr:hover { background-color: #e6f2ff; cursor: pointer; }
        .sort-icon { margin-left: 5px; font-size: 12px; color: rgba(255,255,255,0.5); }
        .sort-icon.active { color: #fff; }
        .header-filter { display: block; width: 100%; margin-top: 8px; padding: 4px; font-size: 11px; font-family: 'Roboto', sans-serif; background-color: #fff; color: var(--text-dark); border: 1px solid #ccc; border-radius: 4px; cursor: pointer; outline: none; }
        .btn-cargar-mas { width: 100%; padding: 12px; background-color: var(--light-gray); color: var(--primary-blue); text-align: center; font-weight: 700; cursor: pointer; border: none; border-bottom: 1px solid var(--border-color); }
        .btn-cargar-mas:hover { background-color: #e0e0e0; }

        /* FICHA TÉCNICA */
        .detail-card { border: 1px solid var(--primary-blue); margin-top: 30px; display: none; background-color: #fff; }
        .strict-table { display: flex; flex-direction: column; width: 100%; border-bottom: 2px solid var(--primary-blue); }
        .st-row { display: flex; width: 100%; border-bottom: 1px solid var(--primary-blue); min-height: 35px; }
        .st-row:last-child { border-bottom: none; }
        .st-label { background-color: var(--primary-blue); color: var(--text-light); font-weight: 700; font-size: 14px; padding: 8px 15px; display: flex; align-items: center; justify-content: center; text-align: center; flex: 0 0 25%; box-sizing: border-box; border-right: 1px solid #fff; }
        .st-value { background-color: #fff; color: var(--text-dark); font-size: 14px; font-weight: 500; padding: 8px 15px; display: flex; align-items: center; flex-wrap: wrap; gap: 4px; flex: 0 0 25%; box-sizing: border-box; border-right: 1px solid var(--primary-blue); }
        .st-label:last-child, .st-value:last-child { border-right: none; }
        .st-value.full-val { flex: 0 0 75%; }
        .st-value.right-align { justify-content: flex-end; }
        .action-link { font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 5px; color: var(--text-dark); font-size: 13px; }
        .action-link:hover { text-decoration: underline; color: var(--primary-blue); }

        /* ZONA DE MEDIOS */
        .media-container { padding: 20px; display: flex; justify-content: center; align-items: center; background-color: #ffffff; min-height: 400px; position: relative; }
        .media-container img { max-width: 100%; max-height: 400px; object-fit: contain; }
        model-viewer { width: 100%; height: 400px; background-color: #ffffff; --poster-color: transparent; }
        .action-btn-group { position: absolute; bottom: 15px; right: 15px; display: flex; gap: 10px; }
        .btn-accion { background-color: #fff; border: 1px solid var(--border-color); padding: 8px 15px; font-weight: 700; font-size: 13px; cursor: pointer; display: flex; align-items: center; gap: 8px; border-radius: 4px; transition: background 0.2s; }
        .btn-accion:hover { background-color: #e0e0e0; }

        /* PANTALLA DE CARGA (SPINNER) */
        .loader-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(255,255,255,0.9); display: flex; flex-direction: column; justify-content: center; align-items: center; z-index: 99999; }
        .spinner { width: 50px; height: 50px; border: 5px solid var(--light-gray); border-top: 5px solid var(--primary-blue); border-radius: 50%; animation: spin 1s linear infinite; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

        /* CHIPS ESTÉTICOS Y PALETAS */
        .chip { display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 500; margin: 0; white-space: nowrap; }
        .chip-bryke { background-color: #fce8e6; color: #d93025; }
        .chip-one { background-color: #fef7e0; color: #e37400; }
        .chip-glare { background-color: #e6f4ea; color: #1e8e3e; }
        .chip-concept { background-color: #e8f0fe; color: #1967d2; }
        .chip-fantasy { background-color: #f3e8fd; color: #9334e6; }
        .chip-produccion { background-color: #e8f0fe; color: #1967d2; }
        .chip-tecnico { background-color: #e6f4ea; color: #1e8e3e; }
        .chip-refaccion { background-color: #acc6de; color: #363f32; }
        .chip-consumible { background-color: #c6b09a; color: #383a3c; }
        .chip-herramienta { background-color: #e8eaed; color: #160101; }
        .chip-si { color: #1e8e3e; font-weight: 700; }
        .chip-no { color: #d93025; font-weight: 700; }
        
        .chip-purple { background-color: #f3e8fd; color: #9334e6; }
        .chip-blue { background-color: #e8f0fe; color: #1967d2; }
        .chip-green { background-color: #e6f4ea; color: #1e8e3e; }
        .chip-yellow { background-color: #fef7e0; color: #ea8600; }
        .chip-lightorange { background-color: #feefe3; color: #e65100; }
        .chip-red { background-color: #fce8e6; color: #d93025; }
        .chip-teal { background-color: #00bfa5; color: #ffffff; }
        .chip-darkorange { background-color: #e67c73; color: #ffffff; }
        .chip-gray { background-color: #f1f3f4; color: #3c4043; }

        @media (max-width: 768px) {
            .app-container { padding: 10px; }
            .st-label, .st-value { font-size: 11px; padding: 6px 4px; }
            .control-label { width: 100px; font-size: 11px; padding: 0 10px; }
            .action-btn-group { flex-direction: column; bottom: 10px; right: 10px; }
            .carousel-card.large { width: 75vw; min-width: 260px; height: 62vh; }
            .carousel-card.large .carousel-img-container { height: calc(100% - 50px); padding: 15px; }
        }

        /* MODAL UNIFICADO */
        .modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); display: none; justify-content: center; align-items: center; z-index: 9999; padding: 20px; }
        .modal-content { background: #fff; width: 100%; max-width: 900px; max-height: 80vh; display: flex; flex-direction: column; border: 1px solid var(--border-color); box-shadow: 0 10px 30px rgba(0,0,0,0.3); overflow: hidden; }
        .modal-header { display: flex; justify-content: space-between; align-items: center; background-color: var(--primary-blue); color: var(--text-light); border-bottom: 1px solid var(--border-color); }
        .modal-title { padding: 12px 15px; font-size: 15px; font-weight: 700; }
        .modal-close { background: #f2f2f2; border: none; border-left: 1px solid var(--border-color); width: 45px; height: 100%; font-size: 24px; cursor: pointer; display: flex; justify-content: center; align-items: center; }
        .modal-body { overflow-y: auto; overflow-x: auto; background: #fff; }
        .modal-body table { width: 100%; border-collapse: collapse; table-layout: fixed; }
        .modal-body th { background-color: var(--primary-blue); color: var(--text-light); text-align: left; padding: 10px 15px; font-weight: 500; border-bottom: 2px solid var(--border-color); border-right: 1px solid rgba(255,255,255,0.2); font-size: 13px; }
        .modal-body td { padding: 10px 15px; border-bottom: 1px solid var(--border-color); border-right: 1px solid #ddd; font-size: 13px; word-wrap: break-word; vertical-align: middle; }
        .modal-img { max-width: 100%; max-height: 70px; object-fit: contain; }
    </style>
</head>
<body>
    
    <div id="loaderOverlay" class="loader-overlay">
        <div class="spinner"></div>
        <div id="loaderText" style="margin-top: 15px; font-weight: 500; color: var(--primary-blue);">Sincronizando catálogo...</div>
    </div>

    <div class="app-container">
        <div class="header-logo">
            <img src="https://github.com/JuanRomeror/Activos-BC/blob/main/LOGOODNsinfondo.png?raw=true" alt="Logo Operaciones del Norte" class="header-logo-img" id="logoEmpresa">
        </div>

        <div class="control-row">
            <div class="control-label">Categoría</div>
            <div class="select-wrapper">
                <select id="categoriaSelect" onchange="mostrarListado()" disabled>
                    <option value="">Conectando con base de datos...</option>
                </select>
                <div class="select-arrow"><i class="fa-solid fa-angle-down"></i></div>
            </div>
        </div>

        <div class="control-row">
            <div class="control-label">Búsqueda</div>
            <div class="control-input">
                <input type="text" id="searchInput" placeholder="Buscar por código, nombre o modelo..." onkeyup="ejecutarBusqueda()">
            </div>
            <button class="search-btn" title="Buscar" onclick="ejecutarBusqueda()"><i class="fa-solid fa-folder-open"></i></button>
        </div>

        <!-- CARRUSEL SEPARADO -->
        <div id="menuPrincipalContainer">
            <div class="carousel-container" id="menuMaquinasContainer" style="display: block;">
                <div class="carousel-title"><i class="fa-solid fa-desktop"></i> SELECCIONA UNA MÁQUINA PARA FILTRAR:</div>
                <div class="carousel-track" id="touchMenuMarcasMaquinas"></div>
            </div>
            <div class="carousel-container" id="menuSignsContainer" style="display: block;">
                <div class="carousel-title"><i class="fa-solid fa-solar-panel"></i> SELECCIONA UN SIGN PARA FILTRAR:</div>
                <div class="carousel-track" id="touchMenuMarcasSigns"></div>
            </div>
        </div>

        <!-- LISTADO -->
        <div id="vistaListado" class="results-table-container">
            <table>
                <thead>
                    <tr>
                        <th onclick="ordenarTabla(0)">Código NAVISION <i id="sortIcon0" class="sort-icon fa-solid fa-sort"></i></th>
                        <th onclick="ordenarTabla(1)">Código ON <i id="sortIcon1" class="sort-icon fa-solid fa-sort"></i></th>
                        <th onclick="ordenarTabla(2)">Descripción <i id="sortIcon2" class="sort-icon fa-solid fa-sort"></i></th>
                        <th>Marca 
                            <select id="filtroMarca" class="header-filter" onchange="aplicarFiltrosCabecera()" style="display:none;"><option value="">Todas</option></select>
                        </th>
                        <th>Modelo / Sign
                            <select id="filtroModelo" class="header-filter" onchange="aplicarFiltrosCabecera()"><option value="">Todos los modelos</option></select>
                        </th>
                        <th>Tipo
                            <select id="filtroTipo" class="header-filter" onchange="aplicarFiltrosCabecera()"><option value="">Todos los tipos</option></select>
                        </th>
                    </tr>
                </thead>
                <tbody id="tablaResultadosCuerpo"></tbody>
            </table>
            <button id="btnCargarMas" class="btn-cargar-mas" onclick="cargarMasPagina()" style="display: none;">Cargar más resultados <i class="fa-solid fa-chevron-down"></i></button>
        </div>

        <!-- FICHA TÉCNICA -->
        <div id="vistaDetalle" class="detail-card">
            <div class="strict-table">
                <div class="st-row">
                    <div class="st-label">Descripción</div>
                    <div class="st-value full-val" id="detDescripcion">-</div>
                </div>
                <div class="st-row">
                    <div class="st-label">Código NAVISION</div>
                    <div class="st-value" id="detCodigoNav">-</div>
                    <div class="st-label">Código ON</div>
                    <div class="st-value" id="detCodigoON">-</div>
                </div>
                <div class="st-row">
                    <div class="st-label">Equipo</div>
                    <div class="st-value" id="detEquipo">-</div>
                    <div class="st-label">Categoría</div>
                    <div class="st-value" id="detCat">-</div>
                </div>
                <div class="st-row">
                    <div class="st-label">Sub Categoría</div>
                    <div class="st-value full-val" id="detSubcat">-</div>
                </div>
                <div class="st-row">
                    <div class="st-label">Marca</div>
                    <div class="st-value" id="detMarca">-</div>
                    <div class="st-label">Mod. / Sign</div>
                    <div class="st-value" id="detModeloSign">-</div>
                </div>
                <div class="st-row">
                    <div class="st-label">Tipo</div>
                    <div class="st-value" id="detTipo">-</div>
                    <div class="st-label">Reparable</div>
                    <div class="st-value" id="detReparable">-</div>
                </div>
                <div class="st-row">
                    <div class="st-label">Quién puede solicitar</div>
                    <div class="st-value full-val" id="detSolicitante">-</div>
                </div>
                <div class="st-row">
                    <div class="st-label">Relación</div>
                    <div class="st-value full-val right-align">
                        <span class="action-link" id="linkRefacciones">Ver refacciones de este componente <i class="fa-solid fa-magnifying-glass-plus"></i></span>
                    </div>
                </div>
            </div>
            
            <div class="media-container">
                <img id="detImagen" src="" alt="Imagen del componente" onerror="this.onerror=null; this.src='https://placehold.co/600x400/eeeeee/333333?text=Sin+Imagen';">
                <model-viewer id="detModelo3D" src="" alt="Modelo 3D" auto-rotate camera-controls style="display: none;"></model-viewer>
                <a id="linkDocOculto" href="#" target="_blank" style="display: none;"></a>
                
                <div class="action-btn-group">
                    <button class="btn-accion" id="btnInfoOculto" style="display: none;" onclick="abrirDocumentoInfo()">Información/Planos <i class="fa-solid fa-sitemap"></i></button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL UNIFICADO -->
    <div id="modalGenerico" class="modal-overlay" onclick="cerrarModalFuera(event)">
        <div class="modal-content">
            <div class="modal-header">
                <div id="modalTitulo" class="modal-title">Listado</div>
                <button class="modal-close" onclick="cerrarModal()">&#10005;</button>
            </div>
            <div class="modal-body">
                <table>
                    <thead>
                        <tr>
                            <th style="width: 20%; text-align: center;">Imagen</th>
                            <th style="width: 25%;">Código NAVISION</th>
                            <th style="width: 20%;">Código ON</th>
                            <th style="width: 35%; border-right: none;">Descripción</th>
                        </tr>
                    </thead>
                    <tbody id="modalTablaCuerpo"></tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        function escapeHTML(str) {
            if (!str) return "";
            return String(str).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }
        
        function escapeJS(str) {
            if (!str) return "";
            return String(str).replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/"/g, "\\\"").replace(/\n/g, "\\n").replace(/\r/g, "\\r");
        }

        function obtenerValorSeguro(item, posiblesNombres) {
            for(var i=0; i<posiblesNombres.length; i++) {
                var nombre = posiblesNombres[i];
                if (item[nombre] !== undefined && item[nombre] !== null) {
                    return String(item[nombre]);
                }
            }
            return "";
        }

        // ====================================================================
        // DICCIONARIOS Y CONFIGURACIÓN
        // ====================================================================
        var MODO_CARRUSEL_SIGN = 'A'; 

        var imagenesMaquinasCatalog = {
            "BRYKE": "https://github.com/JuanRomeror/Activos-BC/blob/main/BRYKE.png?raw=true",
            "ONE": "https://github.com/JuanRomeror/Activos-BC/blob/main/SL1.png?raw=true",
            "GLARE": "https://github.com/JuanRomeror/Activos-BC/blob/main/MAQ/ALTIUS.png?raw=true",
            "CONCEPT": "https://github.com/JuanRomeror/Activos-BC/blob/main/MAQ/MODELOS/PRIME.png?raw=true",
            "FANTASY": "https://github.com/JuanRomeror/Activos-BC/blob/main/MAQ/FANTASY.png?raw=true",
            "BLACKWAVE PLUS": "https://github.com/JuanRomeror/Activos-BC/blob/main/BLACKWAVEPLUS.png?raw=true",
            "PRIME": "https://github.com/JuanRomeror/Activos-BC/blob/main/MAQ/MODELOS/PRIME.png?raw=true",
            "PRIME J": "https://github.com/JuanRomeror/Activos-BC/blob/main/MAQ/MODELOS/PRIME%20J.png?raw=true",
            "DELUXE": "https://github.com/JuanRomeror/Activos-BC/blob/main/MAQ/MODELOS/DELUXE.png?raw=true",
            "ALLURE": "https://github.com/JuanRomeror/Activos-BC/blob/main/MAQ/MODELOS/ALLURE.png?raw=true",
            "ALTIUS": "https://github.com/JuanRomeror/Activos-BC/blob/main/MAQ/MODELOS/ALTIUS.png?raw=true",
            "FUSION": "https://github.com/JuanRomeror/Activos-BC/blob/main/MAQ/MODELOS/FUSION.png?raw=true",
            "ILLUSION PLUS": "https://github.com/JuanRomeror/Activos-BC/blob/main/MAQ/MODELOS/ILLUSION%20PLUS.png?raw=true",
            "ILLUSION": "https://github.com/JuanRomeror/Activos-BC/blob/main/MAQ/MODELOS/ILLUSION.png?raw=true",
            "SLANTOP SL1": "https://github.com/JuanRomeror/Activos-BC/blob/main/MAQ/MODELOS/SL1.png?raw=true",
            "ALLURE AL1": "https://github.com/JuanRomeror/Activos-BC/blob/main/MAQ/MODELOS/AL1.png?raw=true",
            "ILLUSION IL1": "https://github.com/JuanRomeror/Activos-BC/blob/main/MAQ/MODELOS/IL1.png?raw=true",
