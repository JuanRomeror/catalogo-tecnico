        function iniciarAplicacion(datosDesdeExcel) {
            try {
                if (!datosDesdeExcel || datosDesdeExcel.length === 0) throw new Error("El Excel respondió vacío.");
                
                baseDeDatos = [];
                var categoriasArray = [];

                for(var i=0; i<datosDesdeExcel.length; i++){
                    var itemNormalizado = normalizarItem(datosDesdeExcel[i]);
                    baseDeDatos.push(itemNormalizado);
                    
                    var catVal = itemNormalizado.categoria;
                    if (catVal) {
                        var checkVal = catVal.toUpperCase();
                        if (checkVal !== "MAQUINA" && checkVal !== "SIGN" && checkVal !== "BRACKET" && checkVal.indexOf("MAQUINA") === -1 && checkVal.indexOf("SIGN") === -1) {
                            if (categoriasArray.indexOf(catVal) === -1) {
                                categoriasArray.push(catVal);
                            }
                        }
                    }
                }
                
                selectCat.innerHTML = '<option value="">Seleccione una categoría...</option>';
                for(var c=0; c<categoriasArray.length; c++){
                    selectCat.innerHTML += '<option value="' + escapeHTML(categoriasArray[c]) + '">' + escapeHTML(categoriasArray[c]) + '</option>';
                }
                selectCat.disabled = false;
                
                resultadosBase = baseDeDatos; 
                actualizarCarousel(baseDeDatos);
                
                if (window.history && window.history.replaceState) window.history.replaceState({ view: 'listado' }, "");
                
            } catch (e) {
                if (loaderText) { loaderText.textContent = "Error: " + e.message; loaderText.style.color = "red"; }
            } finally {
                if (loader) loader.style.display = 'none';
            }
        }

