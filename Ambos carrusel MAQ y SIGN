                var val = valores[i].trim();
                if(!val) continue;
                
                var txtLimpio = val.toLowerCase();
                var claseChip = "chip-produccion"; 
                
                if (txtLimpio === "maquina") claseChip = "chip-blue";
                else if (txtLimpio === "sign") claseChip = "chip-purple";
                else if (txtLimpio === "bracket") claseChip = "chip-lightorange";
                else if (txtLimpio === "si") claseChip = "chip-si";
                else if (txtLimpio === "no") claseChip = "chip-no";
                else if (txtLimpio === "tecnico") claseChip = "chip-tecnico";
                else if (txtLimpio === "componente") claseChip = "chip-yellow"; 
                else if (txtLimpio === "refaccion") claseChip = "chip-refaccion";
                else if (txtLimpio === "consumible") claseChip = "chip-consumible";
                else if (txtLimpio === "herramienta") claseChip = "chip-herramienta";
                else if (txtLimpio === "estructura") claseChip = "chip-darkorange";
                else if (txtLimpio === "crown" || txtLimpio === "panel led") claseChip = "chip-purple";
                else if (txtLimpio === "double ring" || txtLimpio === "3x3 fantasy" || txtLimpio === "pantalla" || txtLimpio === "tarjeta receptora") claseChip = "chip-blue";
                else if (txtLimpio === "blast" || txtLimpio === "fuente alimentacion" || txtLimpio === "iluminacion led") claseChip = "chip-green";
                else if (txtLimpio === "tesla" || txtLimpio === "controlador") claseChip = "chip-yellow";
                else if (txtLimpio === "circular tipo c" || txtLimpio === "progresivos") claseChip = "chip-lightorange";
                else if (txtLimpio === "concept 2x2" || txtLimpio === "cableado") claseChip = "chip-red";
                else if (txtLimpio === "concept 3x3" || txtLimpio === "kit") claseChip = "chip-gray";
                else if (txtLimpio === "acrilico" || txtLimpio === "panoramico") claseChip = "chip-teal";
                else if (txtLimpio.indexOf("bryke") > -1 || txtLimpio.indexOf("blackwave") > -1) claseChip = "chip-bryke";
                else if (txtLimpio.indexOf("one") > -1 || txtLimpio.indexOf("slantop") > -1 || txtLimpio.indexOf("allure") > -1) claseChip = "chip-one";
                else if (txtLimpio.indexOf("glare") > -1 || txtLimpio.indexOf("altius") > -1 || txtLimpio.indexOf("fusion") > -1 || txtLimpio.indexOf("illusion") > -1) claseChip = "chip-glare";
