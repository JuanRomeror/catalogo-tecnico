        function onCarouselClick(valor, tipo) {
            var cat = selectCat.value;
            var search = document.getElementById('searchInput').value.trim();
            
            if(document.getElementById('filtroModelo')) document.getElementById('filtroModelo').value = "";
            if(document.getElementById('filtroTipo')) document.getElementById('filtroTipo').value = "";
            
            if (valor === "") {
                if (carouselNivel === 'MODELO') {
                    carouselNivel = 'MARCA';
                    marcaTacticaSeleccionada = "";
                    modeloTactivoSeleccionado = "";
                    tipoMenuActivo = 'AMBOS';
                    if (cat === "" && search === "") {
                        vistaListado.style.display = 'none';
                        resultadosBase = baseDeDatos;
                    }
                } else {
                    marcaTacticaSeleccionada = "";
                    modeloTactivoSeleccionado = "";
                    tipoMenuActivo = 'AMBOS';
                    if (cat === "" && search === "") {
                        vistaListado.style.display = 'none';
                        resultadosBase = baseDeDatos;
                    }
                }
            } else {
                if (carouselNivel === 'MARCA') {
                    marcaTacticaSeleccionada = valor;
                    tipoMenuActivo = tipo; 
                    carouselNivel = 'MODELO'; 
                    modeloTactivoSeleccionado = ""; 
                } else if (carouselNivel === 'MODELO') {
                    modeloTactivoSeleccionado = valor; 
                }
            }
            
            actualizarCarruseles(resultadosBase);
            aplicarFiltrosCabecera();
            
            setTimeout(function() {
                var activeContainer = tipoMenuActivo === 'SIGN' ? touchMenuMarcasSigns : touchMenuMarcasMaquinas;
