                if (catItem === cat) resultadosBase.push(baseDeDatos[i]);
            }
            
            marcaTacticaSeleccionada = ""; 
            modeloTactivoSeleccionado = "";
            carouselNivel = 'MARCA';
            tipoMenuActivo = 'AMBOS';
            actualizarCarruseles(resultadosBase); 
            aplicarFiltrosCabecera(); 
        }

        function ejecutarBusqueda() {
            var inputLimpio = limpiarTexto(document.getElementById('searchInput').value);
            vistaDetalle.style.display = 'none';
            
            if (inputLimpio === "") { mostrarListado(); return; }
            selectCat.value = ""; 
            
            if(document.getElementById('filtroModelo')) document.getElementById('filtroModelo').value = "";
            if(document.getElementById('filtroTipo')) document.getElementById('filtroTipo').value = "";
            
            var terminos = inputLimpio.split(/\s+/);
            
            resultadosBase = [];
            for(var i=0; i<baseDeDatos.length; i++){
                var item = baseDeDatos[i];
                var txtCompleto = "";
                
                for (var key in item) {
                    if (item.hasOwnProperty(key)) {
                        txtCompleto += limpiarTexto(item[key]) + " ";
                    }
                }
                
                var matchesAll = true;
                for(var t=0; t<terminos.length; t++){
                    if(txtCompleto.indexOf(terminos[t]) === -1) {
                        matchesAll = false; break;
                    }
                }
                if (matchesAll) resultadosBase.push(item);
            }
            
            marcaTacticaSeleccionada = ""; 
            modeloTactivoSeleccionado = "";
            carouselNivel = 'MARCA';
            tipoMenuActivo = 'AMBOS';
            actualizarCarruseles(resultadosBase);
            aplicarFiltrosCabecera();
        }

        // ====================================================================
        // RENDERIZADO DE TABLAS
        // ====================================================================
        var resultadosEnTabla = [];
        function renderizarTabla(resultados, mensajeVacio, resetearPaginacion) {
            if (resetearPaginacion) {
                paginaActual = 1;
                resultadosEnTabla = resultados;
                tablaCuerpo.innerHTML = '';
            }
            
            var inicio = (paginaActual - 1) * filasPorPagina;
            var fin = paginaActual * filasPorPagina;
            var lote = resultadosEnTabla.slice(inicio, fin);

            if(resultadosEnTabla.length === 0) {
                tablaCuerpo.innerHTML = '<tr><td colspan="6" style="text-align:center;">' + escapeHTML(mensajeVacio) + '</td></tr>';
                document.getElementById('btnCargarMas').style.display = 'none';
            } else {
                for(var i=0; i<lote.length; i++){
                    var item = lote[i];
                    var tr = document.createElement('tr');
                    tr.onclick = (function(currentItem) {
                        return function() { mostrarDetalle(currentItem); };
                    })(item);
                    
                    var cNav = obtenerValorSeguro(item, ['codigoNav', 'codigoNavision', 'Código NAVISION', 'Columna 1']) || '-';
                    var cON = obtenerValorSeguro(item, ['codigoON', 'codigoOn', 'Código ON']) || '-';
                    var cDesc = obtenerValorSeguro(item, ['descripcion', 'Descripcion', 'Descripción']);
                    var cMarca = obtenerValorSeguro(item, ['marcaText', 'marca', 'Marca']);
                    
                    var cMod = obtenerValorSeguro(item, ['modeloText', 'modelo', 'Modelo']);
                    var cSign = obtenerValorSeguro(item, ['sign', 'Sign', 'SIGN']);
                    var showMod = cMod !== "" ? cMod : cSign; 
                    
                    var cTipo = obtenerValorSeguro(item, ['tipo', 'Tipo']);
                    
                    var html = '<td>' + escapeHTML(cNav) + '</td>';
                    html += '<td>' + escapeHTML(cON) + '</td>';
                    html += '<td>' + escapeHTML(cDesc) + '</td>';
                    html += '<td>' + generarChipsHTML(cMarca) + '</td>';
                    html += '<td>' + generarChipsHTML(showMod) + '</td>';
                    html += '<td>' + generarChipsHTML(cTipo) + '</td>';
                    
                    tr.innerHTML = html;
                    tablaCuerpo.appendChild(tr);
                }
                
                if (fin < resultadosEnTabla.length) { document.getElementById('btnCargarMas').style.display = 'block'; } 
                else { document.getElementById('btnCargarMas').style.display = 'none'; }
            }
            vistaListado.style.display = 'block';
        }

        function cargarMasPagina() {
            paginaActual++;
            renderizarTabla(resultadosEnTabla, "", false);
        }

        // ====================================================================
        // LLENADO DE VISTA DETALLE
        // ====================================================================
        function mostrarDetalle(itemData) {
            if (window.history && window.history.pushState) {
                if (vistaListado.style.display === 'block') {
                    var estadoLista = { 
                        cat: selectCat.value, 
                        busq: document.getElementById('searchInput').value, 
                        marcaTactil: marcaTacticaSeleccionada, 
                        modelo: document.getElementById('filtroModelo') ? document.getElementById('filtroModelo').value : "",
                        tipo: document.getElementById('filtroTipo') ? document.getElementById('filtroTipo').value : "",
                        menuAct: tipoMenuActivo
                    };
                    window.history.pushState({ view: 'detalle', state: estadoLista }, "");
                }
            }

            vistaListado.style.display = 'none';
            menuPrincipalContainer.style.display = 'none';
            
            document.getElementById('detDescripcion').textContent = obtenerValorSeguro(itemData, ['descripcion', 'Descripcion', 'Descripción']) || "-";
            document.getElementById('detCodigoNav').textContent = obtenerValorSeguro(itemData, ['codigoNav', 'codigoNavision', 'Código NAVISION', 'Columna 1']) || "-";
            document.getElementById('detCodigoON').textContent = obtenerValorSeguro(itemData, ['codigoON', 'codigoOn', 'Código ON']) || "-";
            document.getElementById('detSign').innerHTML = generarChipsHTML(obtenerValorSeguro(itemData, ['sign', 'Sign', 'SIGN']));
            document.getElementById('detMarca').innerHTML = generarChipsHTML(obtenerValorSeguro(itemData, ['marcaText', 'marca', 'Marca']));
            document.getElementById('detModelo').innerHTML = generarChipsHTML(obtenerValorSeguro(itemData, ['modeloText', 'modelo', 'Modelo']));
            document.getElementById('detTipo').innerHTML = generarChipsHTML(obtenerValorSeguro(itemData, ['tipo', 'Tipo']));
            document.getElementById('detReparable').innerHTML = generarChipsHTML(obtenerValorSeguro(itemData, ['reparableText', 'reparable', 'Reparable']));
            document.getElementById('detMaterial').innerHTML = generarChipsHTML(obtenerValorSeguro(itemData, ['material', 'Material', 'MATERIAL']));
            document.getElementById('detSolicitante').innerHTML = generarChipsHTML(obtenerValorSeguro(itemData, ['solicitanteText', 'solicitante', 'Quien puede solicitar la refaccion']));
            
            var linkRefacciones = document.getElementById('linkRefacciones');
            var refDe = obtenerValorSeguro(itemData, ['refaccionDe', 'refaccion', 'Refacción de']);
            
            if (refDe.trim() !== "") {
                linkRefacciones.innerHTML = 'Pertenece a: ' + escapeHTML(refDe) + ' <i class="fa-solid fa-link"></i>';
                linkRefacciones.style.display = 'flex'; 
                linkRefacciones.onclick = function() { abrirModalPadres(itemData); };
            } else { 
                linkRefacciones.innerHTML = 'Listado de refacciones <i class="fa-solid fa-magnifying-glass-plus"></i>';
                linkRefacciones.style.display = 'flex'; 
                linkRefacciones.onclick = function() { abrirModalRefacciones(itemData); };
            }

            var imgElement = document.getElementById('detImagen');
            var visor3D = document.getElementById('detModelo3D');
            var btnInfo = document.getElementById('btnInfoOculto');
            
            var imgVal = obtenerValorSeguro(itemData, ['img', 'imagen', 'Imagen', 'Img']);
            var mod3DVal = obtenerValorSeguro(itemData, ['modelo3D', 'modelo3d', 'Modelo 3D']);
            urlInfoActual = obtenerValorSeguro(itemData, ['infoUrl', 'infourl', 'Enlace de Información/Planos en Google Drive', 'Plano']);

            if (mod3DVal.trim() !== "") {
                imgElement.style.display = 'none'; 
                visor3D.src = mod3DVal; 
                visor3D.style.display = 'block';
            } else {
                visor3D.style.display = 'none'; 
                visor3D.src = ""; 
                imgElement.src = imgVal; 
                imgElement.style.display = 'block';
            }
            
            if (urlInfoActual.trim() !== "") {
                btnInfo.style.display = 'flex'; 
            } else { 
                btnInfo.style.display = 'none'; 
            }
            
            vistaDetalle.style.display = 'block';
        }
        
        function abrirDocumentoInfo() {
            if (urlInfoActual !== "") {
                var link = document.getElementById('linkDocOculto');
                link.href = urlInfoActual; link.click(); 
            }
        }

        // ====================================================================
        // MODALES
        // ====================================================================
        function abrirModalRefacciones(componentePadre) {
            var refacciones = [];
            var navPadre = limpiarTexto(obtenerValorSeguro(componentePadre, ['codigoNav', 'codigoNavision', 'Código NAVISION', 'Columna 1']));
            var onPadre = limpiarTexto(obtenerValorSeguro(componentePadre, ['codigoON', 'codigoOn', 'Código ON']));
            
            for(var i=0; i<baseDeDatos.length; i++){
                var item = baseDeDatos[i];
                var ref = limpiarTexto(obtenerValorSeguro(item, ['refaccionDe', 'refaccion', 'Refacción de']));
                if (ref !== "") {
                    if ((navPadre !== "" && ref.indexOf(navPadre) > -1) || (onPadre !== "" && ref.indexOf(onPadre) > -1)) {
                        refacciones.push(item);
                    }
                }
            }
            if(refacciones.length > 0) renderizarModalLista(refacciones, "Listado de refacciones");
            else alert("No se encontraron refacciones asociadas para este componente.");
        }

        function abrirModalPadres(componenteHijo) {
            var refHijo = limpiarTexto(obtenerValorSeguro(componenteHijo, ['refaccionDe', 'refaccion', 'Refacción de']));
            if (refHijo === "") return;
            
            var padres = [];
            for(var i=0; i<baseDeDatos.length; i++){
                var item = baseDeDatos[i];
                var nav = limpiarTexto(obtenerValorSeguro(item, ['codigoNav', 'codigoNavision', 'Código NAVISION', 'Columna 1']));
                var on = limpiarTexto(obtenerValorSeguro(item, ['codigoON', 'codigoOn', 'Código ON']));
                if ((nav !== "" && refHijo.indexOf(nav) > -1) || (on !== "" && refHijo.indexOf(on) > -1)) {
                    padres.push(item);
                }
            }
            
            if (padres.length > 0) renderizarModalLista(padres, "Pertenece a");
            else alert("No se encontró la ficha principal en la base de datos.");
        }

        function renderizarModalLista(lista, titulo) {
            var modal = document.getElementById('modalGenerico');
            var tbody = document.getElementById('modalTablaCuerpo');
            document.getElementById('modalTitulo').textContent = titulo;
            tbody.innerHTML = ''; 

            if (lista.length > 0) {
                for(var i=0; i<lista.length; i++){
                    var item = lista[i];
                    var tr = document.createElement('tr');
                    tr.style.cursor = 'pointer'; 
                    tr.onclick = (function(currentItem) {
                        return function() { cerrarModal(); mostrarDetalle(currentItem); };
                    })(item);
                    
                    var cNav = obtenerValorSeguro(item, ['codigoNav', 'codigoNavision', 'Código NAVISION', 'Columna 1']);
                    var cON = obtenerValorSeguro(item, ['codigoON', 'codigoOn', 'Código ON']);
                    var cDesc = obtenerValorSeguro(item, ['descripcion', 'Descripcion', 'Descripción']);
                    var cImg = obtenerValorSeguro(item, ['img', 'imagen', 'Imagen', 'Img']);
                    
                    var html = '<td style="text-align: center;"><img src="' + escapeHTML(cImg) + '" alt="Miniatura" class="modal-img" onerror="this.onerror=null; this.src=\'https://placehold.co/600x400/eeeeee/333333?text=Sin+Imagen\';"></td>';
                    html += '<td>' + escapeHTML(cNav || '-') + '</td>';
                    html += '<td>' + escapeHTML(cON || '-') + '</td>';
                    html += '<td style="border-right: none;">' + escapeHTML(cDesc) + '</td>';
                    
                    tr.innerHTML = html;
                    tbody.appendChild(tr);
                }
            } else {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding: 30px;">No se encontraron resultados.</td></tr>';
            }
            modal.style.display = 'flex';
        }

        function cerrarModal() { document.getElementById('modalGenerico').style.display = 'none'; }
        function cerrarModalFuera(e) { if (e.target && e.target.className && e.target.className.indexOf('modal-overlay') > -1) cerrarModal(); }

        // --- SISTEMA DEL BOTÓN "ATRÁS" DEL NAVEGADOR ---
        window.addEventListener('popstate', function(e) {
            cerrarModal(); 
            
            if (!e.state || e.state.view === 'listado') {
                vistaDetalle.style.display = 'none';
                
                if (e.state && e.state.state) {
                    if(e.state.state.tipo !== undefined && document.getElementById('filtroTipo')) document.getElementById('filtroTipo').value = e.state.state.tipo;
                    if(e.state.state.menuAct !== undefined) tipoMenuActivo = e.state.state.menuAct;
                }

                var cat = selectCat.value;
                var search = document.getElementById('searchInput').value.trim();
                
                if (cat === "" && search === "" && marcaTacticaSeleccionada === "") {
                    vistaListado.style.display = 'none';
                    menuPrincipalContainer.style.display = 'block';
                } else {
                    vistaListado.style.display = 'block';
                    menuPrincipalContainer.style.display = 'block'; 
                }
            } 
            else if (e.state && e.state.view === 'detalle') {
                vistaDetalle.style.display = 'block';
                vistaListado.style.display = 'none';
                menuPrincipalContainer.style.display = 'none';
            }
        });
    </script>
</body>
</html>
