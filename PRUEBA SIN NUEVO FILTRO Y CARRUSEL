        // ====================================================================
        // ARMADURA DE DATOS
        // ====================================================================
        function limpiarTexto(texto) {
            if (texto === undefined || texto === null) return "";
            return String(texto).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
        }

        function textoPlano(texto) {
            if (texto === undefined || texto === null) return "";
            return String(texto).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]/g, "");
        }

        function normalizarItem(item) {
            var itemLimpio = {};
            for (var key in item) {
                if (item[key] !== undefined && item[key] !== null) {
                    itemLimpio[key] = String(item[key]).replace(/\n/g, ',').trim();
                } else {
                    itemLimpio[key] = "";
                }
            }
            return itemLimpio;
        }

        // ====================================================================
        // SISTEMA DE ARRANQUE
        // ====================================================================
        document.addEventListener("DOMContentLoaded", function() {
            var timeoutSeguridad = setTimeout(function() {
                mostrarError({message: "Tiempo agotado. Revisa la conexión con el servidor."});
            }, 15000);

            try {
                if (typeof google !== 'undefined' && google.script) {
                    google.script.run
                        .withSuccessHandler(function(datos) {
                            clearTimeout(timeoutSeguridad); 
                            iniciarAplicacion(datos);
                        })
                        .withFailureHandler(function(err) {
                            clearTimeout(timeoutSeguridad); 
                            mostrarError(err);
                        })
                        .obtenerDatosDeExcel();
                } else {
                    clearTimeout(timeoutSeguridad);
                    mostrarError({message: "Entorno de Google Script no detectado."});
                }
            } catch (err) {
                clearTimeout(timeoutSeguridad);
                mostrarError({message: "Error de ejecución: " + err.message});
            }
        });

        function iniciarAplicacion(datosDesdeExcel) {
            try {
                if (!datosDesdeExcel || datosDesdeExcel.length === 0) throw new Error("El Excel respondió vacío.");
                
                baseDeDatos = [];
                for(var i=0; i<datosDesdeExcel.length; i++){
                    baseDeDatos.push(normalizarItem(datosDesdeExcel[i]));
                }
                
                var categoriasArray = [];
                for(var j=0; j<baseDeDatos.length; j++){
                    var catVal = obtenerValorSeguro(baseDeDatos[j], ['categoria', 'Categoria', 'Categoría', 'Tipo de componente']);
                    if (catVal && categoriasArray.indexOf(catVal) === -1) {
                        categoriasArray.push(catVal);
                    }
                }
                
                selectCat.innerHTML = '<option value="">Seleccione una categoría...</option>';
                for(var c=0; c<categoriasArray.length; c++){
                    selectCat.innerHTML += '<option value="' + escapeHTML(categoriasArray[c]) + '">' + escapeHTML(categoriasArray[c]) + '</option>';
                }
                selectCat.disabled = false;
                
                resultadosBase = baseDeDatos; 
                actualizarCarruseles(baseDeDatos);
                
                if (window.history && window.history.replaceState) window.history.replaceState({ view: 'listado' }, "");
                
            } catch (e) {
                selectCat.innerHTML = '<option value="">Error interno: ' + escapeHTML(e.message) + '</option>';
                if (loaderText) { loaderText.textContent = "Error: " + e.message; loaderText.style.color = "red"; }
            } finally {
                if (loader) loader.style.display = 'none';
            }
        }

        function mostrarError(error) {
            if (selectCat) selectCat.innerHTML = '<option value="">Error: ' + escapeHTML(error.message) + '</option>';
            if (loaderText) { loaderText.textContent = "Error: " + error.message; loaderText.style.color = "red"; }
            if (loader) { loader.style.display = 'flex'; var sp = loader.querySelector('.spinner'); if (sp) sp.style.display = 'none'; }
        }

        // ====================================================================
        // MOTOR DE COLORES DE CHIPS
        // ====================================================================
        function generarChipsHTML(texto) {
            if (!texto || texto === "") return "-";
            var valores = String(texto).split(',');
            var html = "";
            for(var i=0; i<valores.length; i++) {
                var val = valores[i].trim();
                if(!val) continue;
                
                var txtLimpio = val.toLowerCase();
                var claseChip = "chip-produccion"; 
                
                // Categorías de Equipo explícitas
                if (txtLimpio === "maquina") claseChip = "chip-blue";
                else if (txtLimpio === "sign") claseChip = "chip-purple";
                else if (txtLimpio === "bracket") claseChip = "chip-lightorange";
                // Resto de la paleta
                else if (txtLimpio === "si") claseChip = "chip-si";
                else if (txtLimpio === "no") claseChip = "chip-no";
                else if (txtLimpio === "tecnico") claseChip = "chip-tecnico";
                else if (txtLimpio === "componente") claseChip = "chip-yellow"; 
                else if (txtLimpio === "refaccion") claseChip = "chip-refaccion";
                else if (txtLimpio === "consumible") claseChip = "chip-consumible";
                else if (txtLimpio === "herramienta") claseChip = "chip-herramienta";
                else if (txtLimpio === "estructura") claseChip = "chip-darkorange";
                else if (txtLimpio === "crown" || txtLimpio === "panel led") claseChip = "chip-purple";
                else if (txtLimpio === "double ring" || txtLimpio === "3x3 fantasy" || txtLimpio === "pantalla" || txtLimpio === "tarjeta receptora") claseChip = "chip-blue";
                else if (txtLimpio === "blast" || txtLimpio === "fuente alimentacion" || txtLimpio === "iluminacion led") claseChip = "chip-green";
                else if (txtLimpio === "tesla" || txtLimpio === "controlador") claseChip = "chip-yellow";
                else if (txtLimpio === "circular tipo c" || txtLimpio === "progresivos") claseChip = "chip-lightorange";
                else if (txtLimpio === "concept 2x2" || txtLimpio === "cableado") claseChip = "chip-red";
                else if (txtLimpio === "concept 3x3" || txtLimpio === "kit") claseChip = "chip-gray";
                else if (txtLimpio === "acrilico") claseChip = "chip-teal";
                // Máquinas fallback
                else if (txtLimpio.indexOf("bryke") > -1 || txtLimpio.indexOf("blackwave") > -1) claseChip = "chip-bryke";
                else if (txtLimpio.indexOf("one") > -1 || txtLimpio.indexOf("slantop") > -1 || txtLimpio.indexOf("allure") > -1) claseChip = "chip-one";
                else if (txtLimpio.indexOf("glare") > -1 || txtLimpio.indexOf("altius") > -1 || txtLimpio.indexOf("fusion") > -1 || txtLimpio.indexOf("illusion") > -1) claseChip = "chip-glare";
                else if (txtLimpio.indexOf("concept") > -1 || txtLimpio.indexOf("prime") > -1 || txtLimpio.indexOf("deluxe") > -1) claseChip = "chip-concept";
                else if (txtLimpio.indexOf("fantasy") > -1) claseChip = "chip-fantasy";
                
                if (txtLimpio === "si" || txtLimpio === "no") { 
                    html += '<span class="' + claseChip + '">' + escapeHTML(val) + '</span>'; 
                } else { 
                    html += '<span class="chip ' + claseChip + '">' + escapeHTML(val) + '</span>'; 
                }
            }
            return html;
        }

        // ====================================================================
        // LÓGICA DE CARRUSELES DOBLES
        // ====================================================================
        function dibujarTarjetas(itemsArray, tipoActual, sizeClass) {
            var html = '';
            if (carouselNivel === 'MODELO') {
                var classAct = (modeloTactivoSeleccionado === '') ? 'active' : '';
                html += '<div class="carousel-card ' + classAct + '" onclick="onCarouselClick(\'\', \'' + escapeJS(tipoActual) + '\')">';
                html += '<div class="carousel-img-container" style="background-color: #f8f9fa;">';
                html += '<i class="fa-solid fa-layer-group" style="font-size: 50px; color: #ccc;"></i>';
                html += '</div><div class="carousel-label">TODOS LOS EQUIPOS</div></div>';
            }
            for(var n=0; n<itemsArray.length; n++){
                var itemName = itemsArray[n];
                var isActive = false;
                if (carouselNivel === 'MARCA') isActive = (itemName === marcaTacticaSeleccionada);
                else isActive = (itemName === modeloTactivoSeleccionado);
                
                var currentActClass = isActive ? 'active' : '';
                var imgUrl = imagenesMaquinasCatalog[itemName] || ('https://placehold.co/400x500/ffffff/0f355c?text=' + encodeURIComponent(itemName)); 
                
                html += '<div class="carousel-card ' + sizeClass + ' ' + currentActClass + '" onclick="onCarouselClick(\'' + escapeJS(itemName) + '\', \'' + escapeJS(tipoActual) + '\')">';
                html += '<div class="carousel-img-container">';
                html += '<img src="' + escapeHTML(imgUrl) + '" class="carousel-img" alt="' + escapeHTML(itemName) + '" onerror="this.src=\'https://placehold.co/400x500/ffffff/ff0000?text=Error\'">';
                html += '</div><div class="carousel-label">' + escapeHTML(itemName) + '</div></div>';
            }
            return html;
        }

        function actualizarCarruseles(datos) {
            var itemsMaquinas = [];
            var itemsSigns = [];
            
            if (carouselNivel === 'MARCA') {
                for (var marcaM in relacionMarcaModelo) itemsMaquinas.push(marcaM);
                for (var marcaS in relacionMarcaSign) itemsSigns.push(marcaS);
            } 
            else if (carouselNivel === 'MODELO') {
                if (tipoMenuActivo === 'MAQUINA' && relacionMarcaModelo[marcaTacticaSeleccionada]) {
                    itemsMaquinas = relacionMarcaModelo[marcaTacticaSeleccionada].slice();
                } else if (tipoMenuActivo === 'SIGN' && relacionMarcaSign[marcaTacticaSeleccionada]) {
                    itemsSigns = relacionMarcaSign[marcaTacticaSeleccionada].slice();
                }
            }

            var catGlobal = selectCat.value;
            var searchGlobal = document.getElementById('searchInput').value.trim();
            var isLarge = (carouselNivel === 'MARCA' && catGlobal === "" && searchGlobal === "");
            var sizeClass = isLarge ? "large" : "";

            if (catGlobal !== "" || searchGlobal !== "") {
                menuPrincipalContainer.style.display = 'none';
                return;
            }

            menuPrincipalContainer.style.display = 'block';

            if (tipoMenuActivo === 'AMBOS') {
                menuMaquinasContainer.style.display = 'block';
                menuSignsContainer.style.display = 'block';
                touchMenuMarcasMaquinas.innerHTML = dibujarTarjetas(itemsMaquinas, 'MAQUINA', sizeClass);
                touchMenuMarcasSigns.innerHTML = dibujarTarjetas(itemsSigns, 'SIGN', sizeClass);
            } else if (tipoMenuActivo === 'MAQUINA') {
                menuMaquinasContainer.style.display = 'block';
                menuSignsContainer.style.display = 'none';
                touchMenuMarcasMaquinas.innerHTML = dibujarTarjetas(itemsMaquinas, 'MAQUINA', sizeClass);
            } else if (tipoMenuActivo === 'SIGN') {
                menuMaquinasContainer.style.display = 'none';
                menuSignsContainer.style.display = 'block';
                touchMenuMarcasSigns.innerHTML = dibujarTarjetas(itemsSigns, 'SIGN', sizeClass);
            }
        }

        // ====================================================================
