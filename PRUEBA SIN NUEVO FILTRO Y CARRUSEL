        function actualizarDesplegableModelosYTipos(datosFiltrados) {
            var selectModelo = document.getElementById('filtroModelo');
            var modSeleccionado = selectModelo ? selectModelo.value : ""; 
            var selectTipo = document.getElementById('filtroTipo');
            var tipoSeleccionado = selectTipo ? selectTipo.value : "";
            
            var modelosArray = [];
            var tiposArray = [];

            for(var i=0; i<datosFiltrados.length; i++){
                var valMod = obtenerValorSeguro(datosFiltrados[i], ['modeloText', 'modelo', 'Modelo']);
                var valSign = obtenerValorSeguro(datosFiltrados[i], ['sign', 'Sign', 'SIGN']);
                var valTipo = obtenerValorSeguro(datosFiltrados[i], ['tipo', 'Tipo']);
                
                var realMod = valMod !== "" ? valMod : valSign; 

                if(realMod) {
                    var partsM = realMod.split(',');
                    for(var j=0; j<partsM.length; j++){
                        var cleanMod = partsM[j].trim();
                        if (cleanMod !== "" && modelosArray.indexOf(cleanMod) === -1) {
                            modelosArray.push(cleanMod);
                        }
                    }
                }
                
                if(valTipo) {
                    var partsT = valTipo.split(',');
                    for(var t=0; t<partsT.length; t++){
                        var cleanTipo = partsT[t].trim();
                        if (cleanTipo !== "" && tiposArray.indexOf(cleanTipo) === -1) {
                            tiposArray.push(cleanTipo);
                        }
                    }
                }
            }
            
            modelosArray.sort();
            tiposArray.sort();
            
            if (selectModelo) {
                selectModelo.innerHTML = '<option value="">Todos los modelos</option>';
                var modeloValido = false;
                for(var k=0; k<modelosArray.length; k++){
                    var modelo = modelosArray[k];
                    selectModelo.innerHTML += '<option value="' + escapeHTML(modelo) + '">' + escapeHTML(modelo) + '</option>';
                    if (modelo === modSeleccionado) modeloValido = true;
                }
                selectModelo.value = modeloValido ? modSeleccionado : "";
            }

            if (selectTipo) {
                selectTipo.innerHTML = '<option value="">Todos los tipos</option>';
                var tipoValido = false;
                for(var n=0; n<tiposArray.length; n++){
                    var tipo = tiposArray[n];
                    selectTipo.innerHTML += '<option value="' + escapeHTML(tipo) + '">' + escapeHTML(tipo) + '</option>';
                    if (tipo === tipoSeleccionado) tipoValido = true;
                }
                selectTipo.value = tipoValido ? tipoSeleccionado : "";
            }
        }

        // ====================================================================
        // MOTOR DE RUTEO MAESTRO (BASADO ESTRICTAMENTE EN COLUMNA "EQUIPO")
        // ====================================================================
        function aplicarFiltrosCabecera() {
            var filtrados = [];
            for(var i=0; i<resultadosBase.length; i++){
                filtrados.push(resultadosBase[i]);
            }

            // 1. FILTRO DE MARCA O EQUIPO (Ruteo Inteligente)
            if (marcaTacticaSeleccionada !== "") {
                var temp = [];
                var marcaLimpia = textoPlano(marcaTacticaSeleccionada);
                
                for(var j=0; j<filtrados.length; j++){
                    var valMarca = obtenerValorSeguro(filtrados[j], ['marcaText', 'marca', 'Marca']);
                    var valMod = obtenerValorSeguro(filtrados[j], ['modeloText', 'modelo', 'Modelo']);
                    var valSign = obtenerValorSeguro(filtrados[j], ['sign', 'Sign', 'SIGN']);
                    var valEquipo = obtenerValorSeguro(filtrados[j], ['equipo', 'Equipo']);

                    var mText = textoPlano(valMarca);
                    var modText = textoPlano(valMod);
                    var signText = textoPlano(valSign);
                    var eqText = textoPlano(valEquipo);
                    
                    var pasaFiltroEquipo = false;

                    // Lógica estricta de Clasificador Maestro (Columna "Equipo")
                    if (eqText !== "") {
                        if (tipoMenuActivo === 'MAQUINA' && eqText.indexOf('maquina') > -1) pasaFiltroEquipo = true;
                        if (tipoMenuActivo === 'SIGN' && eqText.indexOf('sign') > -1) pasaFiltroEquipo = true;
                        // Preparado para BRACKET: if (tipoMenuActivo === 'BRACKET' && eqText.indexOf('bracket') > -1) pasaFiltroEquipo = true;
                    } else {
                        // Lógica de compatibilidad si la celda Equipo quedó vacía en el Excel
                        var isSignRowFallback = (signText !== "");
                        if (tipoMenuActivo === 'MAQUINA' && !isSignRowFallback) pasaFiltroEquipo = true;
                        if (tipoMenuActivo === 'SIGN' && isSignRowFallback) pasaFiltroEquipo = true;
                    }

                    if (!pasaFiltroEquipo) continue;

                    // Si es del equipo correcto, verifica la coincidencia de texto
                    if (mText.indexOf(marcaLimpia) > -1 || modText.indexOf(marcaLimpia) > -1 || signText.indexOf(marcaLimpia) > -1) {
                        temp.push(filtrados[j]);
                    }
                }
                filtrados = temp;
            }
            
            actualizarDesplegableModelosYTipos(filtrados);
            
            // 2. FILTRO MODELO
            var modeloSel = modeloTactivoSeleccionado !== "" ? modeloTactivoSeleccionado : (document.getElementById('filtroModelo') ? document.getElementById('filtroModelo').value : "");
            if (modeloSel !== "") {
                var temp2 = [];
                var modSelLimpio = textoPlano(modeloSel);
                for(var k=0; k<filtrados.length; k++){
                    var valMod2 = obtenerValorSeguro(filtrados[k], ['modeloText', 'modelo', 'Modelo']);
                    var valSign2 = obtenerValorSeguro(filtrados[k], ['sign', 'Sign', 'SIGN']);
                    
                    var modText2 = textoPlano(valMod2);
                    var signText2 = textoPlano(valSign2);
                    
                    if (modText2.indexOf(modSelLimpio) > -1 || signText2.indexOf(modSelLimpio) > -1) { 
                        temp2.push(filtrados[k]); 
                    }
                }
                filtrados = temp2;
            }

            // 3. FILTRO TIPO
            var tipoSel = document.getElementById('filtroTipo') ? document.getElementById('filtroTipo').value : "";
            if (tipoSel !== "") {
                var temp3 = [];
                var tipoSelLimpio = textoPlano(tipoSel);
                for(var t=0; t<filtrados.length; t++){
                    var valTipo = obtenerValorSeguro(filtrados[t], ['tipo', 'Tipo']);
                    var tipoText = textoPlano(valTipo);
                    if (tipoText.indexOf(tipoSelLimpio) > -1) { 
                        temp3.push(filtrados[t]); 
                    }
                }
                filtrados = temp3;
            }
            
            var cat = selectCat.value;
            var search = document.getElementById('searchInput').value.trim();
            
            if (cat === "" && search === "" && marcaTacticaSeleccionada === "") {
                vistaListado.style.display = 'none';
            } else {
                if(columnaOrden !== -1) { ordenarDatosInterno(filtrados); }
                renderizarTabla(filtrados, "No se encontraron componentes para esta selección.", true);
            }
        }

        function ordenarTabla(colIndex) {
            if (columnaOrden === colIndex) { ordenAscendente = !ordenAscendente; } 
            else { columnaOrden = colIndex; ordenAscendente = true; }

            for(var i=0; i<=2; i++) {
                var icono = document.getElementById('sortIcon'+i);
                if(icono) icono.className = 'sort-icon fa-solid fa-sort';
            }
            var iconoActivo = document.getElementById('sortIcon'+colIndex);
            if(iconoActivo) {
                iconoActivo.className = ordenAscendente ? 'sort-icon active fa-solid fa-sort-up' : 'sort-icon active fa-solid fa-sort-down';
            }

            aplicarFiltrosCabecera();
        }

        function ordenarDatosInterno(arreglo) {
            if(columnaOrden === -1) return;
            arreglo.sort(function(a, b) {
                var valA = ""; var valB = "";
                if (columnaOrden === 0) {
                    valA = obtenerValorSeguro(a, ['codigoNav', 'codigoNavision', 'Código NAVISION', 'Columna 1']).toLowerCase();
                    valB = obtenerValorSeguro(b, ['codigoNav', 'codigoNavision', 'Código NAVISION', 'Columna 1']).toLowerCase();
                } else if (columnaOrden === 1) {
                    valA = obtenerValorSeguro(a, ['codigoON', 'codigoOn', 'Código ON']).toLowerCase();
                    valB = obtenerValorSeguro(b, ['codigoON', 'codigoOn', 'Código ON']).toLowerCase();
                } else {
                    valA = obtenerValorSeguro(a, ['descripcion', 'Descripcion', 'Descripción']).toLowerCase();
                    valB = obtenerValorSeguro(b, ['descripcion', 'Descripcion', 'Descripción']).toLowerCase();
                }
                
                if (valA < valB) return ordenAscendente ? -1 : 1;
                if (valA > valB) return ordenAscendente ? 1 : -1;
                return 0;
            });
        }

